{
  "$ref": "#/definitions/events",
  "definitions": {
    "events": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "titel": {
            "type": "string"
          },
          "titelEn": {
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "integer",
                "format": "unix-time"
              }
            ]
          },
          "ende": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "integer",
                "format": "unix-time"
              }
            ]
          },
          "ort": {
            "type": "string"
          },
          "stadt": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "enum": [
              "travemuende",
              "umgebung"
            ]
          },
          "kategorie": {
            "type": "string",
            "enum": [
              "Festival",
              "Konzert",
              "Party",
              "Kultur",
              "Markt",
              "Sport",
              "Maritim"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mit-kindern",
                "open-air",
                "indoor",
                "kostenlos"
              ]
            }
          },
          "preis": {
            "type": "string"
          },
          "preisEn": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "beschreibungEn": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "quelle": {
            "type": "string",
            "format": "uri"
          },
          "zuletztGeprueft": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "integer",
                "format": "unix-time"
              }
            ]
          }
        },
        "required": [
          "id",
          "titel",
          "titelEn",
          "start",
          "ende",
          "ort",
          "stadt",
          "region",
          "kategorie",
          "tags",
          "preis",
          "preisEn",
          "beschreibung",
          "beschreibungEn",
          "url",
          "quelle",
          "zuletztGeprueft"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}